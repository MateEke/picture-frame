[Unit]
Description=Suspend the picture frame during the night

[Timer]
# Every 30 minutes from 23:00 through 06:30. The script itself only runs
# inside the configured window, so a manual start outside it is a no-op.
OnCalendar=*-*-* 23,00,01,02,03,04,05,06:00/30:00
AccuracySec=1min
Persistent=false
Unit=picture-frame-night-suspend.service

[Install]
WantedBy=timers.target