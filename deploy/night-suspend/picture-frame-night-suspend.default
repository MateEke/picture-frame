# /etc/default/picture-frame-night-suspend
# Local-time schedule for the automatic overnight suspend.
# The frame suspends at the first 30-minute tick inside the window and wakes
# via the RTC alarm at WAKE_AT.
# These values are set at install time from the Go config and can be edited
# directly or overridden via the web UI after a restart.
SUSPEND_START="23:00"
SUSPEND_END="06:30"
WAKE_AT="07:00"

# RTC device and rtcwake binary; defaults are correct for the Surface 3.
RTC="/dev/rtc0"
RTWAKE="/usr/sbin/rtcwake"